# ClinicFlow Backend Environment Configuration
APP_ENV=development
APP_DEBUG=true
APP_BASE_PATH=/
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL / PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinicflow
DB_USER=root
DB_PASS=

# Session Security
SESSION_NAME=clinicflow_session
SESSION_LIFETIME=86400
SESSION_SECURE=false

# Brevo (Sendinblue) Email API
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
SECRETARY_EMAIL=
