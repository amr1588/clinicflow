# ============================================================================
# ClinicFlow Backend Root .htaccess
# Denies direct web access to all files outside public/
# This protects .env, config/, api/, helpers.php, mail.php, etc.
# Only public/index.php should be web-accessible.
# ============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
